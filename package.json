{
  "name": "nippes-nights",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @nn/client && node scripts/precompress.mjs",
    "start": "npm start -w @nn/server",
    "typecheck": "tsc --noEmit -p apps/client && tsc --noEmit -p packages/shared && tsc --noEmit -p packages/pipeline && tsc --noEmit -p apps/server",
    "pipeline": "node --max-old-space-size=10240 --import tsx packages/pipeline/src/main.ts",
    "board-shots": "node scripts/board-shots.mjs",
    "car-shots": "node scripts/car-shots.mjs",
    "ship-cars": "tsx packages/pipeline/src/ship-cars.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "drive-check": "node scripts/drive-check.mjs",
    "accept": "node scripts/accept.mjs",
    "ride-check": "node scripts/ride-check.mjs",
    "mp-check": "node scripts/mp-check.mjs",
    "ride-along-check": "node scripts/ride-along-check.mjs",
    "transit-check": "node scripts/transit-check.mjs",
    "loadtest": "tsx apps/server/src/bots/loadtest.ts",
    "touch-check": "node scripts/touch-check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/three": {
      "@dimforge/rapier3d-compat": "0.21.0"
    }
  }
}
