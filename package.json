{
  "name": "nippes-nights",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @nn/client",
    "typecheck": "tsc --noEmit -p apps/client && tsc --noEmit -p packages/shared && tsc --noEmit -p packages/pipeline && tsc --noEmit -p apps/server",
    "pipeline": "tsx packages/pipeline/src/main.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "drive-check": "node scripts/drive-check.mjs",
    "accept": "node scripts/accept.mjs",
    "ride-check": "node scripts/ride-check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/three": {
      "@dimforge/rapier3d-compat": "0.21.0"
    }
  }
}
