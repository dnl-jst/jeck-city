# Copy to deploy/.env and adjust.
# Domain whose DNS A/AAAA record points at this server; Caddy fetches the certificate for it.
DOMAIN=nippes.example.org
# Image from the GitHub Action (or a locally built one, e.g. nippes-nights:local).
IMAGE=ghcr.io/dnl-jst/nippes-nights:latest
MAX_PLAYERS=60
LOG_LEVEL=info
