# Copy to deploy/.env and adjust.
# Domain whose DNS A/AAAA record points at this server; Caddy fetches the certificate for it.
DOMAIN=nippes.example.org
# Image from the GitHub Action (or a locally built one, e.g. nippes-nights:local).
IMAGE=ghcr.io/dnl-jst/nippes-nights:latest
MAX_PLAYERS=60
LOG_LEVEL=info
# Public URL of the world in object storage (published by CI with `npm run world:publish`); browsers load the world
# from there. Empty: the game server serves the world itself (needs an image built with WORLD_FILES=full). Only set it
# once the bucket's CORS rule (deploy/object-storage-cors.json) is in place.
WORLD_URL=
# e.g. WORLD_URL=https://jeck-city.nbg1.your-objectstorage.com/
# Seconds of restart countdown players see before the server stops (0-600); keep below stop_grace_period (90s).
RESTART_NOTICE_S=60
